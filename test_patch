+import { afterAll, beforeAll, describe, expect, it, Level } from '@ohos/hypium';
+import { abilityDelegatorRegistry, Driver } from '@kit.TestKit';
+import { findLogoutButton, openSettingsPage, startAbility } from './TestHelper';
+
+export default function passToPassTest() {
+  describe('SettingsPassToPassTest', () => {
+    let driver: Driver;
+    let bundleName: string;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+      bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+      await startAbility(driver, bundleName);
+      await openSettingsPage(driver);
+    })
+
+    afterAll(async () => {
+      await driver.waitForIdle(2000, 3000);
+    })
+
+    it('should_have_logout_button_before_and_after_fix', Level.LEVEL0, async (done: Function) => {
+      try {
+        // Pass-to-pass checks existence only. It must not assert whether the
+        // logout button overlaps the menu.
+        const logout = await findLogoutButton(driver, bundleName);
+        expect(logout !== null).assertTrue();
+      } catch (e) {
+        console.error('should_have_logout_button_before_and_after_fix error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+  })
+}
